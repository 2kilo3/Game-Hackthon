const VARIANTS := {
	"broken_pots_reply": "花盆……我已经打碎过了！原来刚才记录到的因果偏移，就是这条线索。",
	"broken_pots_advice": "没错。观察未来相同位置已经启动的能量桩，把头目引到它们附近，让它们协助消耗护盾。如果还有未改变的位置，也可以回现代继续调查。（R 往返现代与未来。）",
	"already_future_advice": "你现在已经在 2209 年。终端坐标核对无误，接下来就在这里追查源头。我会保持联系，需要调整策略时也可以返回现代。",
	"already_future_controls": "（R 可在现代与未来之间往返。）"
}

static func lines_for(id: String, pots_broken: bool, already_future: bool) -> Array:
	var lines: Array = LINES.get(id, []).duplicate(true)
	if id == "future_boss_first_death" and pots_broken:
		lines[2].text = VARIANTS.broken_pots_reply
		lines[3].text = VARIANTS.broken_pots_advice
	if id == "talents_closed" and already_future:
		lines[5].text = VARIANTS.already_future_advice
		lines[-1].text = VARIANTS.already_future_controls
	return lines
